---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import LanguageToggle from '../components/LanguageToggle.astro';
import SiteNav from '../components/SiteNav.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Plugins from '../components/Plugins.astro';
import Certifications from '../components/Certifications.astro';
import {
  getAbout,
  getCertifications,
  getExperience,
  getPlugins,
  getProjects,
  getSite,
} from '../lib/content';
import { THEMES } from '../lib/themes';
import { MODE_LABELS, THEME_DESCRIPTIONS } from '../lib/theme-copy';

const [
  aboutEs,
  aboutEn,
  experienceEs,
  experienceEn,
  projectsEs,
  projectsEn,
  pluginsEs,
  pluginsEn,
  certificationsEs,
  certificationsEn,
  siteEs,
  siteEn,
] = await Promise.all([
  getAbout('es'),
  getAbout('en'),
  getExperience('es'),
  getExperience('en'),
  getProjects('es'),
  getProjects('en'),
  getPlugins('es'),
  getPlugins('en'),
  getCertifications('es'),
  getCertifications('en'),
  getSite('es'),
  getSite('en'),
]);

const es = siteEs[0];
const en = siteEn[0];

const brand = es.data.name;
const title = `${brand} — ${es.data.role}`;
const description = es.data.role;

// Build-time star counts for the modal, one request per unique repository.
// Fetched at build because a hand-stored number would go stale, and the build
// already reaches a CDN for fonts. Fail soft: a rate limit, a network error or
// a missing/private repository leaves the count absent and the build succeeds.
// The cache reserves the key before awaiting, so the es and en copies of a card
// share one request instead of fetching the same repo twice per locale.
const GITHUB_REPO = /^https:\/\/github\.com\/([^/\s]+)\/([^/\s?#]+)$/;
const starCounts = new Map<string, number | null>();

async function loadStars(repo: string | undefined): Promise<void> {
  if (!repo || starCounts.has(repo)) return;
  const match = GITHUB_REPO.exec(repo);
  starCounts.set(repo, null);
  if (!match) return;
  try {
    const response = await fetch(`https://api.github.com/repos/${match[1]}/${match[2]}`, {
      headers: { Accept: 'application/vnd.github+json' },
    });
    if (!response.ok) return;
    const payload = (await response.json()) as { stargazers_count?: unknown };
    if (typeof payload.stargazers_count === 'number') {
      starCounts.set(repo, payload.stargazers_count);
    }
  } catch {
    // Network failure or unreachable API: leave the count absent.
  }
}

await Promise.all([...projectsEs, ...projectsEn].map((entry) => loadStars(entry.data.repo)));

const starsByRepo: Record<string, number> = {};
for (const [repo, count] of starCounts) {
  if (count !== null) starsByRepo[repo] = count;
}

// Empty-shell suppression (spec REQ-01 "Empty section"): each locale's section
// block renders only when that locale has at least one entry. The outer anchor
// wrapper renders only when at least one locale has content.
const hasAboutEs = aboutEs.length > 0;
const hasAboutEn = aboutEn.length > 0;
const hasExperienceEs = experienceEs.length > 0;
const hasExperienceEn = experienceEn.length > 0;
const hasProjectsEs = projectsEs.length > 0;
const hasProjectsEn = projectsEn.length > 0;
const hasPluginsEs = pluginsEs.length > 0;
const hasPluginsEn = pluginsEn.length > 0;
const hasCertificationsEs = certificationsEs.length > 0;
const hasCertificationsEn = certificationsEn.length > 0;

// The vertical nav only shows items whose section actually renders (matches the
// empty-shell suppression above), so every nav link has a real deck target.
const navSections: {
  id: string;
  key: 'about' | 'experience' | 'projects' | 'plugins' | 'certifications';
  available: boolean;
}[] = [
  { id: 'about', key: 'about', available: hasAboutEs || hasAboutEn },
  { id: 'experience', key: 'experience', available: hasExperienceEs || hasExperienceEn },
  { id: 'projects', key: 'projects', available: hasProjectsEs || hasProjectsEn },
  { id: 'plugins', key: 'plugins', available: hasPluginsEs || hasPluginsEn },
  { id: 'certifications', key: 'certifications', available: hasCertificationsEs || hasCertificationsEn },
];
const availableNavSections = navSections.filter((section) => section.available).map(({ id, key }) => ({ id, key }));

// Chapter numbers for the section eyebrows (01, 02, …), following deck order.
// Locale-independent, so they work for both copies without touching content.
const sectionIndex = new Map(availableNavSections.map(({ id }, i) => [id, String(i + 1).padStart(2, '0')]));

const year = new Date().getFullYear();
const cvFileEs = es.data.cv?.split('/').pop() ?? '';
const cvFileEn = en.data.cv?.split('/').pop() ?? '';
---

<Base title={title} description={description}>
  <!--
    Split layout: the left column holds identity + nav and stays fixed; the
    right column is a snap-scroll deck. On lg+ the page does not free-scroll
    (h-screen + overflow-hidden), only the deck scrolls internally. Below lg the
    two stack and the page scrolls naturally.

    The grid row must be an explicit minmax(0,1fr) track: with an auto row the
    lg:h-full children resolve against a circular height (content-sized), the
    deck never overflows internally and main clips it to one viewport with no
    scroll. minmax(0,1fr) gives a definite 100vh row so the deck really scrolls.
  -->
  <main
    class="relative mx-auto max-w-7xl lg:grid lg:h-screen lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:grid-rows-[minmax(0,1fr)] lg:gap-20 lg:overflow-hidden"
  >
    <!--
      Page-level controls, anchored to the top-right corner of the content area.
      Absolute on purpose: they sit outside the identity column, which clips its
      overflow, and outside the deck, which scrolls internally, so the palette
      panel can never be cut off no matter how tall it grows.
    -->
    <div class="fixed bottom-4 right-4 z-30 flex items-center gap-2 lg:bottom-auto lg:right-6 lg:top-6">
      <a
        href="#top"
        data-scroll-top
        aria-label="Volver arriba"
        class="flex h-10 w-10 items-center justify-center border border-hairline bg-surface-1 text-ink-subtle transition-colors duration-200 hover:border-hairline-strong hover:text-ink"
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 19V5"></path>
          <path d="m5 12 7-7 7 7"></path>
        </svg>
      </a>

      <button
        type="button"
        data-theme-toggle
        aria-expanded="false"
        aria-controls="theme-menu"
        aria-label="Tema"
        class="flex h-10 w-10 items-center justify-center gap-2 border border-hairline bg-surface-1 text-ink-subtle transition-colors duration-200 hover:border-hairline-strong hover:text-ink lg:w-auto lg:min-w-[13rem] lg:justify-start lg:px-3"
      >
        {/*
          Below lg the cluster sits fixed at the viewport's bottom-right so it is
          reachable while scrolling, which means it hovers over the reading
          column: there it stays icon-only and out of the way. lg keeps the wide
          labelled control anchored to the top-right corner.
        */}
        <svg
          class="size-4 shrink-0 lg:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <path
            d="M12 3a9 9 0 0 0 0 18h1.5a1.5 1.5 0 0 0 1.5-1.5 1.5 1.5 0 0 0-.44-1.06 1.5 1.5 0 0 1 1.06-2.56H17a4 4 0 0 0 4-4A7 7 0 0 0 12 3Z"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <circle cx="8" cy="10" r="1.2" fill="currentColor" />
          <circle cx="12" cy="7.5" r="1.2" fill="currentColor" />
          <circle cx="16" cy="10" r="1.2" fill="currentColor" />
        </svg>
        <span class="hidden font-mono text-[10px] uppercase tracking-[0.14em] lg:inline">
          <span data-locale="es">Tema</span><span data-locale="en" hidden>Theme</span>
        </span>
        <span data-theme-current data-locale="es" class="hidden min-w-0 truncate text-ink lg:block">Tokyo Night</span>
        <span data-theme-current data-locale="en" hidden class="hidden min-w-0 truncate text-ink lg:block">Tokyo Night</span>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="ml-auto hidden size-3.5 shrink-0 lg:block">
          <path d="M6 9.5L12 15.5L18 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
        </svg>
      </button>
    </div>

    <!-- Identity + nav column: content aligned to the top. Static by design on
         lg+ (see .identity-col in global.css): vh-driven clamps compress the
         content on short viewports and overflow:hidden guarantees it never
         scrolls internally. -->
    <aside class="identity-col flex flex-col px-6 pb-8 pt-8 lg:h-full lg:min-h-0 lg:overflow-hidden lg:px-10 lg:py-10">
      <!--
        Navigation controls. The palette switcher and the back-to-top anchor now
        live in the cluster at the top-right of <main>, so this row keeps only
        the command palette and the language switch.
      -->
      <div class="flex items-center justify-end gap-2">
          <button
            type="button"
            data-cmdk-open
            aria-label="Command palette (Ctrl+K)"
            title="Ctrl+K"
            class="flex h-7 w-7 items-center justify-center rounded-md text-ink-subtle transition-colors duration-200 hover:bg-surface-1 hover:text-ink"
          >
            <svg
              class="h-3.5 w-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
          </button>
          <LanguageToggle />
      </div>

      <div class="hero-wrap mt-10 lg:mt-14">
        <Hero
          locale="es"
          name={es.data.name}
          role={es.data.role}
          email={es.data.email}
          linkedin={es.data.linkedin}
          github={es.data.github}
          cv={es.data.cv}
        />
        <Hero
          locale="en"
          name={en.data.name}
          role={en.data.role}
          email={en.data.email}
          linkedin={en.data.linkedin}
          github={en.data.github}
          cv={en.data.cv}
          hidden
        />
      </div>

      <SiteNav nav={{ es: es.data.nav, en: en.data.nav }} items={availableNavSections} />
    </aside>

    <!-- Snap-scroll section deck (lg+). -->
    <div
      data-scroll-root
      class="split-scroller px-6 pb-16 lg:h-full lg:overflow-y-auto lg:px-10 lg:pb-0"
    >
      {(hasAboutEs || hasAboutEn) && (
        <div
          id="about"
          data-section
          class="deck-section lg:flex lg:min-h-full lg:flex-col"
        >
          {hasAboutEs && <About locale="es" index={sectionIndex.get('about') ?? '01'} entries={aboutEs} />}
          {hasAboutEn && <About locale="en" index={sectionIndex.get('about') ?? '01'} entries={aboutEn} hidden />}
        </div>
      )}

      {(hasExperienceEs || hasExperienceEn) && (
        <div
          id="experience"
          data-section
          class="deck-section lg:flex lg:min-h-full lg:flex-col"
        >
          {hasExperienceEs && (
            <Experience
              locale="es"
              index={sectionIndex.get('experience') ?? '02'}
              title={es.data.nav.experience}
              presentLabel="Actualidad"
              entries={experienceEs}
            />
          )}
          {hasExperienceEn && (
            <Experience
              locale="en"
              index={sectionIndex.get('experience') ?? '02'}
              title={en.data.nav.experience}
              presentLabel="Present"
              entries={experienceEn}
              hidden
            />
          )}
        </div>
      )}

      {(hasProjectsEs || hasProjectsEn) && (
        <div
          id="projects"
          data-section
          class="deck-section lg:flex lg:min-h-full lg:flex-col"
        >
          {hasProjectsEs && <Projects locale="es" index={sectionIndex.get('projects') ?? '03'} title={es.data.nav.projects} entries={projectsEs} stars={starsByRepo} />}
          {hasProjectsEn && <Projects locale="en" index={sectionIndex.get('projects') ?? '03'} title={en.data.nav.projects} entries={projectsEn} stars={starsByRepo} hidden />}
        </div>
      )}

      {(hasPluginsEs || hasPluginsEn) && (
        <div
          id="plugins"
          data-section
          class="deck-section lg:flex lg:min-h-full lg:flex-col"
        >
          {hasPluginsEs && <Plugins locale="es" index={sectionIndex.get('plugins') ?? '04'} title={es.data.nav.plugins} entries={pluginsEs} />}
          {hasPluginsEn && <Plugins locale="en" index={sectionIndex.get('plugins') ?? '04'} title={en.data.nav.plugins} entries={pluginsEn} hidden />}
        </div>
      )}

      {(hasCertificationsEs || hasCertificationsEn) && (
        <div
          id="certifications"
          data-section
          class="deck-section lg:flex lg:min-h-full lg:flex-col"
        >
          {hasCertificationsEs && (
            <Certifications
              locale="es"
              index={sectionIndex.get('certifications') ?? '05'}
              title={es.data.nav.certifications}
              entries={certificationsEs}
            />
          )}
          {hasCertificationsEn && (
            <Certifications
              locale="en"
              index={sectionIndex.get('certifications') ?? '05'}
              title={en.data.nav.certifications}
              entries={certificationsEn}
              hidden
            />
          )}
        </div>
      )}

      <!-- Colophon: closes the page; not a snap point, so it can never trap
            the end of the deck. Both locale copies follow the data-locale pattern. -->
      <footer class="px-6">
        <div
          class="flex flex-col gap-3 border-t border-hairline pb-14 pt-8 sm:flex-row sm:items-center sm:justify-between"
          data-reveal
        >
          <p class="text-xs text-ink-subtle">
            <span data-locale="es">© {year} {es.data.name}. Diseñado y desarrollado con Astro y Tailwind CSS.</span>
            <span data-locale="en" hidden>© {year} {en.data.name}. Designed and built with Astro and Tailwind CSS.</span>
          </p>
          <a href={`mailto:${es.data.email}`} class="link-underline w-fit text-xs font-medium text-ink-subtle">
            <span data-locale="es">{es.data.nav.contact}</span>
            <span data-locale="en" hidden>{en.data.nav.contact}</span>
          </a>
        </div>
      </footer>
    </div>
  </main>

  {es.data.cv && (
    <div data-cv-modal data-cv-locale="es" class="cv-modal" hidden>
      <div class="cv-modal-backdrop" data-cv-close></div>
      <div class="cv-modal-panel">
        <div class="cv-modal-titlebar">
          <span>{cvFileEs}</span>
          <button type="button" data-cv-close aria-label="Close CV preview" class="cv-modal-close">
            <svg
              class="h-3.5 w-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M18 6 6 18M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <iframe
          src={`${es.data.cv}#navpanes=0&view=FitH`}
          title="Curriculum Vitae"
          class="cv-modal-frame"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  )}
  {en.data.cv && (
    <div data-cv-modal data-cv-locale="en" class="cv-modal" hidden>
      <div class="cv-modal-backdrop" data-cv-close></div>
      <div class="cv-modal-panel">
        <div class="cv-modal-titlebar">
          <span>{cvFileEn}</span>
          <button type="button" data-cv-close aria-label="Close CV preview" class="cv-modal-close">
            <svg
              class="h-3.5 w-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M18 6 6 18M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <iframe
          src={`${en.data.cv}#navpanes=0&view=FitH`}
          title="Resume"
          class="cv-modal-frame"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  )}

  <!-- Command palette (Ctrl/Cmd+K): sections + quick actions. Labels follow
       the data-locale pattern so the i18n toggle keeps them in sync. -->
  <!--
    Palette panel. Top-level and `fixed` on purpose: the identity column clips
    its overflow, which is what used to cut this list off. scripts/app.ts anchors
    it under the toggle and re-anchors it on resize and on scroll.
  -->
  <div
    id="theme-menu"
    data-theme-menu
    hidden
    class="fixed z-[55] w-80 border border-hairline-strong bg-surface-1 shadow-elevation-hover"
  >
    <p class="border-b border-hairline px-3 py-2 font-mono text-[10px] uppercase tracking-[0.14em] text-ink-tertiary">
      <span data-locale="es">Paletas de tema</span><span data-locale="en" hidden>Theme palettes</span>
    </p>
    <ul role="listbox" aria-label="Tema" class="max-h-[60vh] overflow-y-auto p-1.5">
      {
        THEMES.map((theme) => {
          const copy = THEME_DESCRIPTIONS[theme.name];
          const mode = MODE_LABELS[theme.mode];
          return (
            <li role="presentation">
              <button
                type="button"
                role="option"
                aria-selected="false"
                data-theme-option={theme.name}
                class="flex w-full items-center gap-3 px-2.5 py-2 text-left transition-colors duration-150 hover:bg-surface-2 aria-selected:bg-surface-2"
              >
                <span
                  aria-hidden="true"
                  class="size-3 shrink-0 rounded-full ring-1 ring-hairline-strong"
                  style={`background:${theme.brand}`}
                />
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-[13px] font-medium text-ink">{theme.label}</span>
                  <span class="mt-0.5 block truncate text-[11px] text-ink-muted">
                    <span data-locale="es">{copy.es}</span>
                    <span data-locale="en" hidden>{copy.en}</span>
                  </span>
                </span>
                <span class="shrink-0 font-mono text-[9px] uppercase tracking-[0.1em] text-ink-tertiary">
                  <span data-locale="es">{mode.es}</span>
                  <span data-locale="en" hidden>{mode.en}</span>
                </span>
                <svg
                  data-theme-check
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                  class="size-3.5 shrink-0 text-primary transition-opacity duration-150"
                >
                  <path d="M5 13L9.5 17.5L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
                </svg>
              </button>
            </li>
          );
        })
      }
    </ul>
  </div>

  <!--
    Card detail modal. ONE instance serves every project and plugin card: each
    card carries its payload in data attributes and scripts/app.ts fills this in,
    so the page does not ship a modal per entry per locale.
  -->
  <div class="card-modal" data-card-modal hidden>
    <div class="card-modal-backdrop" data-card-modal-close></div>
    <div
      class="card-modal-panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="card-modal-title"
    >
      <div class="card-modal-cover">
        <img data-card-modal-img alt="" hidden />
        <span
          class="font-mono text-4xl tracking-[0.1em] text-ink-tertiary"
          data-card-modal-monogram
          aria-hidden="true"
        >
        </span>
      </div>

      <div class="card-modal-body">
        <h3 id="card-modal-title" class="text-2xl text-ink" data-card-modal-title></h3>
        <p class="mt-4 text-sm leading-relaxed text-ink-muted" data-card-modal-desc></p>
        <ul class="mt-6 flex flex-wrap gap-1.5" data-card-modal-stack></ul>

        <div class="mt-8 flex flex-wrap items-center gap-3 border-t border-hairline pt-5">
          <a
            class="card-modal-action"
            data-card-modal-repo
            target="_blank"
            rel="noopener noreferrer"
            hidden
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-3.5">
              <path d="M12 .5A11.5 11.5 0 0 0 8.37 22.9c.57.1.78-.25.78-.55v-1.94c-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.25 5.69.41.36.78 1.06.78 2.14v3.17c0 .3.2.66.79.55A11.5 11.5 0 0 0 12 .5Z" />
            </svg>
            GitHub
          </a>
          <span
            class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.14em] text-ink-tertiary"
            data-card-modal-stars
            hidden
          >
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="size-3.5">
              <path
                d="M12 3.4l2.63 5.33 5.87.85-4.25 4.15 1 5.87L12 16.8l-5.25 2.8 1-5.87-4.25-4.15 5.87-.85L12 3.4z"
                stroke="currentColor"
                stroke-width="1.2"
                stroke-linejoin="round"
              />
            </svg>
            <span data-card-modal-stars-count></span>
          </span>
          <a
            class="card-modal-action card-modal-action-ghost"
            data-card-modal-site
            target="_blank"
            rel="noopener noreferrer"
            hidden
          >
            <span data-locale="es">Ver sitio</span><span data-locale="en" hidden>View site</span>
          </a>
          <button
            type="button"
            class="card-modal-action card-modal-action-ghost ml-auto"
            data-card-modal-close
          >
            <span data-locale="es">Cerrar</span><span data-locale="en" hidden>Close</span>
          </button>
        </div>
      </div>

      <button type="button" class="card-modal-x" data-card-modal-close aria-label="Cerrar">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="size-3.5">
          <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
        </svg>
      </button>
    </div>
  </div>

  <div class="cmdk" data-cmdk hidden>
    <div class="cmdk-backdrop" data-cmdk-close></div>
    <div class="cmdk-panel" role="dialog" aria-modal="true" aria-label="Command palette">
      <input
        data-cmdk-input
        type="text"
        autocomplete="off"
        spellcheck="false"
        aria-label="Search commands"
        placeholder="Escribí un comando…"
      />
      <ul class="cmdk-list" data-cmdk-list role="listbox" aria-label="Commands">
        <li role="presentation">
          <button type="button" class="cmdk-item" role="option" data-cmdk-item data-cmdk-goto="about">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"></path><path d="M5 10v10h14V10"></path></svg>
